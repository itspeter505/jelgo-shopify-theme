<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{{ page_title }}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  <link rel="canonical" href="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;700;800&family=Hanken+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {%- liquid
    assign accent = settings.accent
    if template.name == 'product'
      for tag in product.tags
        if tag contains 'pouch:'
          assign accent = tag | remove: 'pouch:' | strip | prepend: '#'
        endif
      endfor
    endif
  -%}
  <style>:root{--p: {{ accent }};}</style>
  <script>
    window.jelgo = {
      root: {{ routes.root_url | json }},
      moneyFormat: {{ shop.money_format | json }},
      freeShip: {{ settings.free_shipping_threshold | times: 100 }},
      pouchColors: {
        {%- for p in collections.all.products limit: 50 -%}
          {%- assign col = settings.accent -%}
          {%- for tag in p.tags -%}{%- if tag contains 'pouch:' -%}{%- assign col = tag | remove: 'pouch:' | strip | prepend: '#' -%}{%- endif -%}{%- endfor -%}
          {{ p.handle | json }}: {{ col | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }
    };
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="visually-skip" href="#main" style="position:absolute;left:-999px">Skip to content</a>
  {% section 'announcement' %}
  {% section 'header' %}
  <main id="main">
    {{ content_for_layout }}
  </main>
  {% section 'footer' %}
  {% render 'cart-drawer' %}
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
</body>
</html>
