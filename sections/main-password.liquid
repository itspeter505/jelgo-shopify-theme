<div class="wrap narrow" style="text-align:center">
  <p class="logo" style="justify-content:center;font-size:34px"><span>{{ shop.name | downcase | escape }}</span><i></i></p>
  <p style="color:var(--muted);margin-top:14px">{{ shop.password_message | default: 'Opening soon.' | escape }}</p>
  {%- form 'storefront_password' -%}
    <div class="field" style="margin-top:28px;text-align:left">
      <label for="pw">Store password</label>
      <input id="pw" type="password" name="password" autocomplete="current-password">
    </div>
    {%- if form.errors -%}<p class="form-err">That password didn't work. Check it and try again.</p>{%- endif -%}
    <button class="btn btn-ink" type="submit" style="width:100%">Enter</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
