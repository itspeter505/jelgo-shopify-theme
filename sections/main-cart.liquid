<div class="wrap">
  <div class="page-head" style="padding-bottom:20px"><h1>Your bag</h1></div>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <div class="table-scroll">
        <table class="cart-table">
          <thead><tr><th>Product</th><th>Quantity</th><th style="text-align:right">Total</th></tr></thead>
          <tbody>
            {%- for item in cart.items -%}
              <tr>
                <td>
                  <a href="{{ item.url }}" style="font-weight:700;text-decoration:none">{{ item.product.title | escape }}</a>
                  <div style="color:var(--muted);font-size:14px">
                    {%- unless item.product.has_only_default_variant -%}{{ item.variant.title | escape }} · {% endunless -%}
                    {%- if item.selling_plan_allocation -%}{{ item.selling_plan_allocation.selling_plan.name | escape }}{%- else -%}One-time{%- endif -%}
                  </div>
                </td>
                <td>
                  <label class="visually-hidden" for="q-{{ forloop.index }}" style="position:absolute;left:-999px">Quantity for {{ item.product.title | escape }}</label>
                  <input id="q-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0">
                  <a href="{{ item.url_to_remove }}" style="margin-left:10px;font-size:14px;color:var(--muted)">Remove</a>
                </td>
                <td style="text-align:right;font-weight:700" class="tnum">{{ item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
      <div class="cart-foot">
        <span style="font-weight:700;font-size:18px">Subtotal <span class="tnum">{{ cart.total_price | money }}</span></span>
        <button class="btn btn-ghost" type="submit" name="update">Update</button>
        <button class="btn btn-ink" type="submit" name="checkout">Check out</button>
      </div>
      <p style="text-align:right;color:var(--muted);font-size:14px;margin-top:10px">Taxes and shipping calculated at checkout.</p>
    </form>
  {%- else -%}
    <p style="color:var(--muted);font-size:18px">Your bag is empty.</p>
    <p style="margin-top:20px"><a class="btn btn-ink" href="{{ routes.all_products_collection_url }}">Shop pouches</a></p>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Cart page", "settings": [] }
{% endschema %}
