{%- liquid
  assign src = section.settings.collection
  if src == blank
    assign src = collections.all
  endif
-%}
<section class="band tight">
  <div class="wrap">
    <div class="sec-head">
      <h2>{{ section.settings.heading | escape }}</h2>
      <a class="btn btn-ghost" href="{{ routes.all_products_collection_url }}">Shop all</a>
    </div>
    <div class="lineup">
      {%- for p in src.products limit: section.settings.limit -%}
        {%- assign uid = section.id | append: 'c' | append: forloop.index -%}
        {%- render 'product-card', p: p, uid: uid -%}
      {%- else -%}
        <p style="color:var(--muted)">Add products to your store and they appear here.</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product lineup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "One daily formula. Five flavours." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to use all products." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 7 }
  ],
  "presets": [{ "name": "Product lineup" }]
}
{% endschema %}
