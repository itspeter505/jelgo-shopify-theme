<div class="wrap">
  <div class="page-head"><h1>{{ blog.title | escape }}</h1></div>
  {%- paginate blog.articles by 12 -%}
    <div class="lineup">
      {%- for article in blog.articles -%}
        <article class="card"><span class="goal">{{ article.published_at | date: '%B %-d, %Y' }}</span><h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3><span class="flav">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</span></article>
      {%- else -%}
        <p style="color:var(--muted)">No posts yet.</p>
      {%- endfor -%}
    </div>
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
