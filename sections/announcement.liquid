{%- if section.settings.text != blank -%}
<div class="announce"><div class="wrap">{{ section.settings.text | escape }}</div></div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Apply code IVEY-STUDENT at checkout for 15% off · Free shipping over $50" }
  ]
}
{% endschema %}
