{%- if section.settings.text != blank -%}
<div class="announce"><div class="wrap">{{ section.settings.text | escape }}</div></div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping across Canada on orders over $50 · 15 vitamins & minerals in every pouch" }
  ]
}
{% endschema %}
