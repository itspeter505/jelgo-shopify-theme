{%- liquid
  assign current = product.selected_or_first_available_variant
  assign goal = ''
  assign pf = ''
  assign tag_pack = 0
  assign pills = ''
  for tag in product.tags
    if tag contains 'goal:'
      assign goal = tag | remove: 'goal:' | strip
    elsif tag contains 'flavour:'
      assign pf = tag | remove: 'flavour:' | strip
    elsif tag contains 'pouches:'
      assign tag_pack = tag | remove: 'pouches:' | strip | plus: 0
    elsif tag contains 'pill:'
      assign pill = tag | remove: 'pill:' | strip
      assign pills = pills | append: pill | append: '||'
    endif
  endfor
  assign pill_list = pills | split: '||'
  assign single = false
  if product.has_only_default_variant
    assign single = true
  endif
  assign lede = ''
  assign rest = product.description
  if product.description contains 'jg-lede'
    assign first_p = product.description | split: '</p>' | first
    assign lede = first_p | strip_html | strip
    assign rest = product.description | remove_first: first_p | remove_first: '</p>'
  endif
  assign has_plans = false
  if product.selling_plan_groups.size > 0
    assign has_plans = true
  endif
-%}
<div class="wrap">
  <div class="pdp">
    <div class="pdp-media{% if product.tags contains 'bundle' and product.featured_image %} full{% endif %}">
      {%- unless product.tags contains 'bundle' -%}<span class="ring" aria-hidden="true"></span>{%- endunless -%}
      {%- if product.tags contains 'spin' -%}
        {%- assign spin_front = 'spin-' | append: product.handle | append: '-front.webp' -%}
        {%- assign spin_back = 'spin-' | append: product.handle | append: '-back.webp' -%}
        {%- assign p3 = '3d-' | append: product.handle -%}
        <div class="spin" data-spin tabindex="0"
          data-3d-front="{{ p3 | append: '-front.webp' | asset_url }}" data-3d-back="{{ p3 | append: '-back.webp' | asset_url }}"
          data-3d-front-height="{{ p3 | append: '-front-height.png' | asset_url }}" data-3d-back-height="{{ p3 | append: '-back-height.png' | asset_url }}"
          data-3d-front-normal="{{ p3 | append: '-front-normal.webp' | asset_url }}" data-3d-back-normal="{{ p3 | append: '-back-normal.webp' | asset_url }}" role="img" aria-label="{{ product.title | escape }} pouch. Drag or use the arrow keys to turn it around and see the back.">
          <span class="spin-shadow" aria-hidden="true"></span>
          <div class="spin-card" data-spin-card>
            <img class="spin-face spin-front" src="{{ spin_front | asset_url }}" alt="" width="800" height="1160" draggable="false" fetchpriority="high">
            <img class="spin-face spin-back" src="{{ spin_back | asset_url }}" alt="" width="800" height="1160" draggable="false" loading="lazy">
          </div>
        </div>
        <div class="spin-ui">
          <span class="spin-hint"><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14.5-4.6M20 12a8 8 0 0 1-14.5 4.6M18.5 3v4.4h-4.4M5.5 21v-4.4h4.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>Drag to spin 360°</span>
          <span class="spin-btns"><button type="button" data-spin-to="0" aria-pressed="true">Front</button><button type="button" data-spin-to="180" aria-pressed="false">Back</button></span>
        </div>
        <script src="{{ 'spin3d.js' | asset_url }}" defer></script>
      {%- else -%}
        <div class="pouch-holder wob">{%- render 'pouch', p: product, uid: section.id -%}</div>
      {%- endif -%}
    </div>
    <div>
      <div class="crumbs"><a href="{{ routes.all_products_collection_url }}">Shop</a><span>/</span><span>{{ product.title | escape }}</span></div>
      {%- if goal != blank -%}<p class="eyebrow">{{ goal | escape }}</p>{%- endif -%}
      <h1>{{ product.title | escape }}</h1>
      {%- if lede != blank -%}<p class="pdp-lede">{{ lede }}</p>{%- endif -%}
      <div class="pills">
        {%- if pf != blank -%}<span class="pill">{{ pf | escape }}</span>{%- endif -%}
        {%- for pl in pill_list -%}{%- if pl != blank -%}<span class="pill">{{ pl | escape }}</span>{%- endif -%}{%- endfor -%}
      </div>

      {%- form 'product', product, data-product-form: '', data-ajax-add: '', novalidate: 'novalidate' -%}
        {%- if single -%}
          {%- liquid
            assign pack = tag_pack
          -%}
          <input type="hidden" name="id" value="{{ current.id }}" data-price="{{ current.price }}" data-pack="{{ pack }}" data-available="{{ current.available }}">
          <div class="opt-label" style="margin-top:24px"><span class="tnum" style="font-family:var(--display);font-size:26px;color:var(--ink);font-weight:700">{{ current.price | money }}</span><span data-per></span></div>
        {%- else -%}
          <fieldset class="opt">
            <legend>{{ product.options.first | escape }} <span data-per></span></legend>
            <div class="sizes">
              {%- for variant in product.variants -%}
                {%- liquid
                  assign pack = variant.option1 | remove: '-pack' | remove: ' pack' | remove: ' pouches' | strip | plus: 0
                  if pack == 0
                    assign pack = tag_pack
                  endif
                -%}
                <div class="size">
                  <input type="radio" id="v-{{ variant.id }}" name="id" value="{{ variant.id }}" data-price="{{ variant.price }}" data-pack="{{ pack }}" data-available="{{ variant.available }}"{% if variant.id == current.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}>
                  <label for="v-{{ variant.id }}"><b>{{ variant.title | escape }}</b><span class="tnum">{{ variant.price | money }}</span></label>
                </div>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endif -%}

        {%- if has_plans -%}
          <fieldset class="opt">
            <legend>How do you want it?</legend>
            <div class="plans">
              {%- for group in product.selling_plan_groups -%}
                {%- for plan in group.selling_plans -%}
                  {%- liquid
                    assign pct = 0
                    assign adj = plan.price_adjustments.first
                    if adj.value_type == 'percentage'
                      assign pct = adj.value
                    endif
                  -%}
                  <div class="plan">
                    <input type="radio" id="sp-{{ plan.id }}" name="selling_plan" value="{{ plan.id }}" data-pct="{{ pct }}"{% if forloop.parentloop.first and forloop.first %} checked{% endif %}>
                    <label for="sp-{{ plan.id }}"><span class="radio"></span><span><b>{{ plan.name | escape }}{% if pct > 0 %}<span class="save">{{ pct }}% off</span>{% endif %}</b><small>{{ section.settings.sub_note | escape }}</small></span><span class="pr tnum" data-plan-price data-plan-pct="{{ pct }}"></span></label>
                  </div>
                {%- endfor -%}
              {%- endfor -%}
              {%- unless product.requires_selling_plan -%}
                <div class="plan">
                  <input type="radio" id="sp-none-{{ section.id }}" name="selling_plan" value="" data-pct="0">
                  <label for="sp-none-{{ section.id }}"><span class="radio"></span><span><b>One-time purchase</b><small>Buy once, no commitment.</small></span><span class="pr tnum" data-plan-price data-plan-pct="0"></span></label>
                </div>
              {%- endunless -%}
            </div>
          </fieldset>
        {%- endif -%}

        <div class="buy">
          <div class="qty">
            <button type="button" data-qty="-1" aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" value="1" min="1" max="99" aria-label="Quantity" inputmode="numeric">
            <button type="button" data-qty="1" aria-label="Increase quantity">+</button>
          </div>
          <button class="btn btn-ink" type="submit" data-add{% unless current.available %} disabled{% endunless %}>{% if current.available %}Add to bag{% else %}Sold out{% endif %}</button>
        </div>
        <p class="form-err" data-form-err role="alert"></p>
        <p class="per" data-ship-hint></p>
      {%- endform -%}

      <div class="acc">
        {%- if has_plans -%}
          <details><summary>How the subscription works</summary><div class="body">{{ section.settings.sub_details | escape }}</div></details>
        {%- endif -%}
        <details><summary>Shipping and returns</summary><div class="body">{{ section.settings.shipping | escape }}</div></details>
      </div>
    </div>
  </div>

  {%- if rest != blank -%}
    <section class="pdp-more">
      <div class="rte jg">{{ rest }}</div>
    </section>
  {%- endif -%}

  <section class="band" style="padding-block:56px 0">
    <div class="sec-head"><h2 style="font-size:28px">{{ section.settings.pairs_heading | escape }}</h2></div>
    <div class="lineup">
      {%- assign shown = 0 -%}
      {%- for p in collections.all.products limit: 12 -%}
        {%- if p.id != product.id and shown < 4 -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- assign uid = section.id | append: 'r' | append: forloop.index -%}
          {%- render 'product-card', p: p, uid: uid -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Product page",
  "settings": [
    { "type": "text", "id": "sub_note", "label": "Subscription line", "default": "Skip, swap flavours or cancel any time." },
    { "type": "textarea", "id": "sub_details", "label": "Subscription details", "default": "Choose a pack and a delivery schedule. You save on every order, and you can skip a delivery, swap flavours or cancel from your account before the next ship date." },
    { "type": "textarea", "id": "shipping", "label": "Shipping and returns", "default": "Orders ship from Ontario in 1–2 business days. Free shipping on orders over $50, otherwise a flat $6.95. If your first box is not for you, contact us within 30 days for a refund on unopened pouches." },
    { "type": "text", "id": "pairs_heading", "label": "Related heading", "default": "Pairs well with" }
  ]
}
{% endschema %}
