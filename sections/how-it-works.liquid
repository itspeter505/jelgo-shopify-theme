<section class="band tight" id="how">
  <div class="wrap">
    <div class="sec-head">
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.intro | escape }}</p>
    </div>
    <div class="squeeze" data-squeeze>
      <div class="squeeze-stick" data-state="1">
        <div class="scene-top">
          <span class="scene-step" data-scene-label>Step 1 · Twist</span>
          <span class="timer tnum" data-scene-timer>0.0 s</span>
        </div>
        <svg class="scene" viewBox="0 0 260 300" role="img" aria-label="A jelgo pouch being opened, squeezed and finished">
          <ellipse cx="130" cy="288" rx="70" ry="7" fill="#000" opacity=".1"/>
          <g class="sc-body">
            <rect x="111" y="40" width="38" height="22" rx="4" fill="#F7F7FA" stroke="#C9CBD6" stroke-width="1.5"/>
            <path d="M70 76 Q70 60 88 60 L172 60 Q190 60 190 76 L200 266 Q201 286 180 286 L80 286 Q59 286 60 266 Z" fill="var(--p)"/>
            <path d="M70 76 Q70 60 88 60 L172 60 Q190 60 190 76 L191 92 L69 92 Z" fill="#fff" opacity=".22"/>
            <rect x="84" y="118" width="92" height="52" rx="24" fill="#fff"/>
            <text x="126" y="152" text-anchor="middle" font-family="Unbounded, sans-serif" font-weight="800" font-size="22" fill="#15172A">jelgo</text>
            <circle cx="164" cy="150" r="4" fill="var(--p)"/>
            <text x="130" y="196" text-anchor="middle" font-family="Hanken Grotesk, sans-serif" font-weight="700" font-size="11" fill="#fff" opacity=".95">daily vitamin jelly</text>
            <path d="M82 70 Q78 170 86 270" stroke="#fff" stroke-width="9" fill="none" stroke-linecap="round" opacity=".18"/>
          </g>
          <g class="sc-drops" fill="var(--p)">
            <circle cx="130" cy="30" r="6"/><circle cx="121" cy="18" r="4"/><circle cx="139" cy="10" r="3.5"/>
          </g>
          <g class="sc-cap">
            <rect x="106" y="8" width="48" height="36" rx="8" fill="#EDEEF4" stroke="#C9CBD6" stroke-width="1.5"/>
            <g stroke="#C9CBD6" stroke-width="1.5"><line x1="116" y1="14" x2="116" y2="38"/><line x1="125" y1="14" x2="125" y2="38"/><line x1="135" y1="14" x2="135" y2="38"/><line x1="144" y1="14" x2="144" y2="38"/></g>
          </g>
          <g class="sc-twist" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round">
            <path d="M96 20 A40 16 0 0 1 164 16"/><path d="M158 8 L165 16 L155 21"/>
          </g>
          <g class="sc-done">
            <circle cx="206" cy="66" r="24" fill="var(--ok)"/>
            <path d="M195 66 L203 74 L218 58" fill="none" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          </g>
        </svg>
        <div class="scene-bar" aria-hidden="true"><i data-scene-bar></i></div>
      </div>
      <div class="steps">
        {%- for block in section.blocks -%}
          <article class="step" {{ block.shopify_attributes }}>
            <span class="n">Step {{ forloop.index }} of {{ forloop.length }}</span>
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps, no cleanup." },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Scroll through the routine. The pouch on the left acts it out, and the clock runs to ten seconds." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Twist the cap." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "The spout opens with a quarter turn." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Twist the cap.", "text": "The spout opens with a quarter turn. No scoop, no measuring, no water." } },
        { "type": "step", "settings": { "title": "Squeeze for ten seconds.", "text": "Each pouch is one serving." } },
        { "type": "step", "settings": { "title": "Cap it and go.", "text": "Nothing to rinse." } }
      ]
    }
  ]
}
{% endschema %}
