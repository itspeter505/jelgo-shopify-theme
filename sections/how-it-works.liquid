<section class="band tight" id="how">
  <div class="wrap">
    <div class="sec-head">
      <h2>{{ section.settings.heading | escape }}</h2>
      <p>{{ section.settings.intro | escape }}</p>
    </div>
    <div class="squeeze" data-squeeze>
      <div class="squeeze-stick" data-state="1" style="--p:#F28C1E">
        <div class="scene-top">
          <span class="scene-step" data-scene-label>Step 1 · Twist</span>
          <span class="timer tnum" data-scene-timer>0.0 s</span>
        </div>
        <div class="scene-photo" role="img" aria-label="A jelgo Orange Mango pouch being opened, squeezed and finished">
          <img class="sp-body" src="{{ 'how-body.webp' | asset_url }}" alt="" width="600" height="774" loading="lazy">
          <img class="sp-cap" src="{{ 'how-cap.webp' | asset_url }}" alt="" width="600" height="126" loading="lazy">
          <span class="sp-drops" aria-hidden="true"><i></i><i></i><i></i></span>
          <svg class="sp-twist" viewBox="0 0 120 40" aria-hidden="true"><path d="M8 26 A52 16 0 0 1 108 20" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round"/><path d="M98 8 L110 20 L95 28" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <svg class="sp-done" viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="24" fill="#1E9E6A"/><path d="M13 24 L21 32 L36 16" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </div>
        <div class="scene-bar" aria-hidden="true"><i data-scene-bar></i></div>
      </div>
      <div class="steps">
        {%- for block in section.blocks -%}
          <article class="step" {{ block.shopify_attributes }}>
            <span class="n">Step {{ forloop.index }} of {{ forloop.length }}</span>
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three steps, no cleanup." },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Scroll through the routine. The pouch acts it out, and the clock runs to ten seconds." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Twist the cap." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "The spout opens with a quarter turn." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Twist the cap.", "text": "The spout opens with a quarter turn. No scoop, no measuring, no water." } },
        { "type": "step", "settings": { "title": "Squeeze for ten seconds.", "text": "Each pouch is one serving." } },
        { "type": "step", "settings": { "title": "Cap it and go.", "text": "Nothing to rinse." } }
      ]
    }
  ]
}
{% endschema %}
