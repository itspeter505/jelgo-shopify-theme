{%- liquid
  assign creator_count = 0
  for block in section.blocks
    if block.type == 'creator'
      assign creator_count = creator_count | plus: 1
    endif
  endfor
-%}
<div class="wrap">
  <div class="cr-hero">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h1>{{ section.settings.heading | escape }}</h1>
      <p class="cr-lede">{{ section.settings.lede | escape }}</p>
      <div class="hero-cta">
        <a class="btn btn-ink" href="#apply">Apply to be a creator</a>
        <a class="btn btn-ghost" href="#spotlight">See the spotlight</a>
      </div>
    </div>
    <div class="cr-stack" aria-hidden="true">
      {%- assign shown = 0 -%}
      {%- for p in collections.all.products limit: 24 -%}
        {%- if p.tags contains 'bundle' or shown >= 3 -%}{%- continue -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- assign uid = section.id | append: 'c' | append: forloop.index -%}
        {%- assign pc = '' -%}{%- for t in p.tags -%}{%- if t contains 'pouch:' -%}{%- assign pc = t | remove: 'pouch:' | strip -%}{%- endif -%}{%- endfor -%}
        <div class="cr-phone"{% if pc != blank %} style="--p:#{{ pc }}"{% endif %}>
          <div class="cr-screen">{%- render 'pouch', p: p, uid: uid -%}</div>
          <span class="cr-tag">{{ section.settings.tag_prefix | escape }} {{ p.title | escape }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>

  <section class="band tight">
    <div class="sec-head"><h2>{{ section.settings.how_heading | escape }}</h2></div>
    <ol class="cr-steps">
      <li><span class="cr-n">1</span><h3>{{ section.settings.s1_title | escape }}</h3><p>{{ section.settings.s1_text | escape }}</p></li>
      <li><span class="cr-n">2</span><h3>{{ section.settings.s2_title | escape }}</h3><p>{{ section.settings.s2_text | escape }}</p></li>
      <li><span class="cr-n">3</span><h3>{{ section.settings.s3_title | escape }}</h3><p>{{ section.settings.s3_text | escape }}</p></li>
    </ol>
  </section>

  <section class="band tight" id="spotlight">
    <div class="sec-head">
      <h2>{{ section.settings.spotlight_heading | escape }}</h2>
      <p>{{ section.settings.spotlight_intro | escape }}</p>
    </div>
    <div class="cr-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'creator' -%}
          <article class="cr-card" {{ block.shopify_attributes }}>
            <div class="cr-media">
              {%- if block.settings.image -%}
                {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', alt: block.settings.name, widths: '350, 700' }}
              {%- else -%}
                <span class="cr-initial">{{ block.settings.name | slice: 0 | upcase }}</span>
              {%- endif -%}
              {%- if block.settings.flavour != blank -%}<span class="cr-flav">{{ block.settings.flavour | escape }}</span>{%- endif -%}
            </div>
            <div class="cr-body">
              <h3>{{ block.settings.name | escape }}</h3>
              <p class="cr-meta">{{ block.settings.handle | escape }}{% if block.settings.platform != blank %} · {{ block.settings.platform | escape }}{% endif %}</p>
              {%- if block.settings.about != blank -%}<p>{{ block.settings.about | escape }}</p>{%- endif -%}
              {%- if block.settings.link != blank -%}<a class="cr-link" href="{{ block.settings.link }}" target="_blank" rel="noopener">Watch the video</a>{%- endif -%}
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
      {%- assign open_slots = 3 | minus: creator_count -%}
      {%- if open_slots < 1 -%}{%- assign open_slots = 1 -%}{%- endif -%}
      {%- for i in (1..open_slots) -%}
        <a class="cr-card cr-empty" href="#apply">
          <div class="cr-media"><span class="cr-plus">+</span></div>
          <div class="cr-body">
            <h3>{{ section.settings.empty_title | escape }}</h3>
            <p>{{ section.settings.empty_text | escape }}</p>
            <span class="cr-link">Apply below</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </section>

  <section class="band tight">
    <div class="sec-head">
      <h2>{{ section.settings.ideas_heading | escape }}</h2>
      <p>{{ section.settings.ideas_intro | escape }}</p>
    </div>
    <div class="cr-ideas">
      {%- for block in section.blocks -%}
        {%- if block.type == 'idea' -%}
          <article class="cr-idea" {{ block.shopify_attributes }}>
            <span class="cr-len tnum">{{ block.settings.length | escape }}</span>
            <h3>{{ block.settings.title | escape }}</h3>
            <p>{{ block.settings.text | escape }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <section class="band tight" id="apply">
    <div class="cr-apply">
      <div>
        <h2>{{ section.settings.apply_heading | escape }}</h2>
        <p class="cr-lede">{{ section.settings.apply_text | escape }}</p>
        <ul class="jg-facts">
          <li>{{ section.settings.perk1 | escape }}</li>
          <li>{{ section.settings.perk2 | escape }}</li>
          <li>{{ section.settings.perk3 | escape }}</li>
        </ul>
      </div>
      <div class="cr-form">
        {%- form 'contact', id: 'creator-apply' -%}
          {%- if form.posted_successfully? -%}
            <div class="cr-ok" role="status"><b>Application sent.</b> Thanks! We read every one and reply within a week.</div>
          {%- else -%}
            {%- if form.errors -%}<p class="form-err" role="alert">Check the highlighted fields and try again.</p>{%- endif -%}
            <input type="hidden" name="contact[subject]" value="Creator application">
            <div class="field"><label for="cr-name">Name</label><input id="cr-name" name="contact[name]" autocomplete="name" required></div>
            <div class="field"><label for="cr-email">Email</label><input id="cr-email" type="email" name="contact[email]" autocomplete="email" required></div>
            <div class="cr-two">
              <div class="field"><label for="cr-handle">Handle</label><input id="cr-handle" name="contact[handle]" placeholder="@yourname" required></div>
              <div class="field"><label for="cr-platform">Main platform</label>
                <select id="cr-platform" name="contact[platform]"><option>TikTok</option><option>Instagram</option><option>YouTube</option><option>Other</option></select></div>
            </div>
            <div class="field"><label for="cr-followers">Followers (roughly)</label><input id="cr-followers" name="contact[followers]" inputmode="numeric" placeholder="e.g. 12,000"></div>
            <div class="field"><label for="cr-why">What would your 10-second video be?</label><textarea id="cr-why" name="contact[body]" rows="4" placeholder="Your routine, your commute, your gym bag…"></textarea></div>
            <button class="btn btn-ink" type="submit" style="width:100%">Send application</button>
            <p class="jg-small" style="color:var(--muted);font-size:13px;margin-top:10px">Applications go to the jelgo team by email. This is a student concept store, so the program is in planning.</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Creator program",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "jelgo creators" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Show us your ten seconds." },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "We're building jelgo with the people who actually use it. Film how a pouch fits into your day, and we'll send the boxes, share your video and give your followers a code." },
    { "type": "text", "id": "tag_prefix", "label": "Phone caption prefix", "default": "▶" },
    { "type": "header", "content": "How it works" },
    { "type": "text", "id": "how_heading", "label": "Heading", "default": "How the program works" },
    { "type": "text", "id": "s1_title", "label": "Step 1 title", "default": "We send you a box" },
    { "type": "textarea", "id": "s1_text", "label": "Step 1 text", "default": "A free 30-Day Variety Box, so you can find your flavour and film it in your real routine." },
    { "type": "text", "id": "s2_title", "label": "Step 2 title", "default": "You film ten seconds" },
    { "type": "textarea", "id": "s2_text", "label": "Step 2 text", "default": "Twist, squeeze, go: on your commute, at your desk or in your gym bag. Your style, your words, no script." },
    { "type": "text", "id": "s3_title", "label": "Step 3 title", "default": "Your followers save" },
    { "type": "textarea", "id": "s3_text", "label": "Step 3 text", "default": "You get a personal code for 15% off your followers' first order, and we feature your video on this page." },
    { "type": "header", "content": "Spotlight" },
    { "type": "text", "id": "spotlight_heading", "label": "Heading", "default": "Creator spotlight" },
    { "type": "textarea", "id": "spotlight_intro", "label": "Intro", "default": "Real people, real routines. We're choosing our first creators now." },
    { "type": "text", "id": "empty_title", "label": "Open slot title", "default": "Your video here" },
    { "type": "textarea", "id": "empty_text", "label": "Open slot text", "default": "We're picking our first five creators. Commuters, gym regulars and frequent flyers especially welcome." },
    { "type": "header", "content": "Content ideas" },
    { "type": "text", "id": "ideas_heading", "label": "Heading", "default": "Ideas that work" },
    { "type": "textarea", "id": "ideas_intro", "label": "Intro", "default": "Short, real and in the moment. Here's what we'd love to see." },
    { "type": "header", "content": "Application" },
    { "type": "text", "id": "apply_heading", "label": "Heading", "default": "Apply to be a jelgo creator" },
    { "type": "textarea", "id": "apply_text", "label": "Text", "default": "Any size of following is welcome. We care more about how real your routine is than how many people watch it." },
    { "type": "text", "id": "perk1", "label": "Perk 1", "default": "A free 30-Day Variety Box to start" },
    { "type": "text", "id": "perk2", "label": "Perk 2", "default": "Your own 15% code for your followers" },
    { "type": "text", "id": "perk3", "label": "Perk 3", "default": "Your video featured in the spotlight" }
  ],
  "blocks": [
    {
      "type": "creator",
      "name": "Creator",
      "settings": [
        { "type": "paragraph", "content": "Only add real creators who have agreed to be featured." },
        { "type": "text", "id": "name", "label": "Name", "default": "Creator name" },
        { "type": "text", "id": "handle", "label": "Handle", "default": "@handle" },
        { "type": "text", "id": "platform", "label": "Platform", "default": "TikTok" },
        { "type": "image_picker", "id": "image", "label": "Photo or video still" },
        { "type": "text", "id": "flavour", "label": "Favourite flavour" },
        { "type": "textarea", "id": "about", "label": "About their routine" },
        { "type": "url", "id": "link", "label": "Video link" }
      ]
    },
    {
      "type": "idea",
      "name": "Content idea",
      "settings": [
        { "type": "text", "id": "length", "label": "Length", "default": "10 s" },
        { "type": "text", "id": "title", "label": "Title", "default": "The 7 a.m. train" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Film your pouch on the platform, start to finish." }
      ]
    }
  ],
  "presets": [{ "name": "Creator program" }]
}
{% endschema %}
