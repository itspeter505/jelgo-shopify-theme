<div class="wrap narrow">
  <h1>Reset your password</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field" style="margin-top:24px"><label for="rs-pw">New password</label><input id="rs-pw" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field"><label for="rs-pw2">Confirm password</label><input id="rs-pw2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="btn btn-ink" type="submit" style="width:100%">Reset password</button>
  {%- endform -%}
</div>
