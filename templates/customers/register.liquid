<div class="wrap narrow">
  <h1>Create an account</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <div class="field" style="margin-top:24px"><label for="reg-first">First name</label><input id="reg-first" type="text" name="customer[first_name]" autocomplete="given-name"></div>
    <div class="field"><label for="reg-last">Last name</label><input id="reg-last" type="text" name="customer[last_name]" autocomplete="family-name"></div>
    <div class="field"><label for="reg-email">Email</label><input id="reg-email" type="email" name="customer[email]" autocomplete="email" required></div>
    <div class="field"><label for="reg-pw">Password</label><input id="reg-pw" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <button class="btn btn-ink" type="submit" style="width:100%">Create account</button>
  {%- endform -%}
</div>
